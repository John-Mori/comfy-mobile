const $ = id => document.getElementById(id), storage = "comfy-mobile-settings";
let base = localStorage.getItem("comfy-mobile-worker") || "", pass = localStorage.getItem("comfy-mobile-pass") || "", timer;
$("workerUrl").value = base; $("pass").value = pass;
function headers(){return {"content-type":"application/json","x-comfy-pass":pass}};
async function api(path, init={}) { const r = await fetch(base.replace(/\/$/,"")+path,{...init,headers:{...headers(),...(init.headers||{})}}); if(!r.ok) throw new Error(r.status===401?"合言葉かWorker URLが違う":`通信に失敗した(${r.status})`); return r.status===204?null:r.json(); }
function fill(id, values, empty=true){const s=$(id);s.replaceChildren();if(empty)s.add(new Option("使わない",""));values.forEach(x=>s.add(new Option(x,x)));}
function saveForm(){const v={};document.querySelectorAll("#jobForm input,#jobForm select,#jobForm textarea").forEach(e=>v[e.id]=e.value);localStorage.setItem(storage,JSON.stringify(v));}
function restoreForm(){try{const v=JSON.parse(localStorage.getItem(storage)||"{}");Object.entries(v).forEach(([k,x])=>{if($(k))$(k).value=x})}catch{}}
async function connect(){base=$("workerUrl").value.trim().replace(/\/$/,"");pass=$("pass").value; if(!base||!pass)throw new Error("Worker URLと合言葉を入れて");const caps=await api("/api/capabilities");fill("checkpoint",caps.checkpoints||[],false);fill("lora1",caps.loras||[]);fill("lora2",caps.loras||[]);restoreForm();localStorage.setItem("comfy-mobile-worker",base);localStorage.setItem("comfy-mobile-pass",pass);$("connectionCard").hidden=true;$("jobForm").hidden=false;$("connection").textContent=`接続中: ${caps.updatedAt ? new Date(caps.updatedAt).toLocaleString("ja-JP",{timeZone:"Asia/Tokyo"}) : "PCの一覧待ち"}`;}
function settings(){const loras=[1,2].map(n=>({name:$("lora"+n).value,strength:Number($("strength"+n).value)})).filter(x=>x.name);return {checkpoint:$("checkpoint").value,loras,positive:$("positive").value,negative:$("negative").value,size:$("size").value,steps:Number($("steps").value),cfg:Number($("cfg").value),sampler:$("sampler").value,scheduler:$("scheduler").value,seed:$("seed").value===""?null:Number($("seed").value),count:Number($("count").value)};}
async function watch(id, started){$("result").hidden=false;const status=$("status");clearInterval(timer);const tick=async()=>{status.textContent=`生成中: ${Math.floor((Date.now()-started)/1000)}秒`;try{const job=await api(`/api/jobs/${id}`);if(job.status==="done"){clearInterval(timer);const img=$("image");img.src=`${base}/image/${id}`;img.hidden=false;$("sendDiscord").hidden=false;status.textContent="完了";await api(`/api/jobs/${id}/shown`,{method:"POST",body:"{}"});}else if(job.status==="failed"){clearInterval(timer);status.textContent="失敗: "+(job.error||"不明");}}catch(e){status.textContent=e.message}};await tick();timer=setInterval(tick,3000);}
$("connect").onclick=()=>connect().catch(e=>$("connection").textContent=e.message);
$("jobForm").onsubmit=async e=>{e.preventDefault();saveForm();const b=$("jobForm").querySelector("button[type=submit]");b.disabled=true;try{const j=await api("/api/jobs",{method:"POST",body:JSON.stringify(settings())});await watch(j.id,Date.now())}catch(err){$("status").textContent=err.message;$("result").hidden=false}finally{b.disabled=false}};
$("sendDiscord").onclick=async()=>{try{await api(`/api/jobs/${$("image").src.split("/").pop()}/discord`,{method:"POST",body:"{}"});$("sendDiscord").disabled=true;$("sendDiscord").textContent="送信待ち"}catch(e){$("status").textContent=e.message}};
if(base&&pass) connect().catch(()=>{});
